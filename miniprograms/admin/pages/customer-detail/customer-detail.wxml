<view class="page">
  <view class="section">
    <view class="section-title">客户详情</view>
    <view class="field"><view class="field-label">公司名称 / 用户名字 <text class="required">*</text></view><input class="input" value="{{form.name}}" data-field="name" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">联系人</view><input class="input" value="{{form.contact}}" data-field="contact" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">客户类型</view><input class="input" value="{{form.type}}" data-field="type" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">微信名 <text class="required">*</text></view><input class="input" value="{{form.wechat}}" data-field="wechat" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">联系电话 <text class="required">*</text></view><input class="input" value="{{form.phone}}" data-field="phone" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">常用地址 <text class="required">*</text></view><input class="input" value="{{form.address}}" data-field="address" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">客户备注</view><textarea class="textarea" value="{{form.note}}" data-field="note" bindinput="inputField" /></view>
    <view class="btn {{submitting ? 'btn-disabled' : 'btn-primary'}}" bindtap="save">保存客户资料</view>
    <view wx:if="{{message}}" class="toast">{{message}}</view>
  </view>
</view>
