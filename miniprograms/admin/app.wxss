page {
  background: #f7f5ef;
  color: #12231c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page { padding: 24rpx 24rpx 144rpx; }
.section { margin-top: 22rpx; padding: 24rpx; background: #fff; border: 1rpx solid #e8dcc8; border-radius: 16rpx; }
.section-title { color: #005536; font-size: 32rpx; font-weight: 800; margin-bottom: 18rpx; }
.row { display: flex; justify-content: space-between; gap: 20rpx; padding: 12rpx 0; font-size: 27rpx; }
.label { color: #69766f; flex: none; }
.value { text-align: right; font-weight: 700; }
.muted { color: #69766f; }
.input, .textarea { min-height: 84rpx; border: 1rpx solid #ded2c0; border-radius: 12rpx; padding: 0 20rpx; box-sizing: border-box; background: #fff; font-size: 28rpx; }
.picker-value { display: flex; align-items: center; font-weight: 700; }
.textarea { min-height: 144rpx; padding-top: 18rpx; }
.field { margin-top: 20rpx; }
.field-label { margin-bottom: 10rpx; font-weight: 700; }
.required { color: #b3261e; }
.tabs { display: flex; gap: 12rpx; overflow-x: auto; padding: 12rpx 0; white-space: nowrap; }
.tab { flex: none; padding: 16rpx 20rpx; border-radius: 999rpx; border: 1rpx solid #eadfcc; background: #fff; color: #69766f; font-size: 25rpx; }
.tab.active { background: #005536; color: #fff; border-color: #005536; font-weight: 800; }
.btn { min-height: 84rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 29rpx; }
.btn-primary { color: #fff; background: #007846; }
.btn-secondary { color: #005536; background: #eef6f1; border: 1rpx solid #005536; }
.btn-ghost { color: #005536; background: #fff; border: 1rpx solid #ded2c0; }
.btn-danger { color: #8a241d; background: #fff2ef; border: 1rpx solid #e8b6ad; }
.btn-disabled { color: #8a8f8b; background: #ece8df; }
.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
.empty { padding: 80rpx 0; color: #69766f; text-align: center; }
.toast { margin-top: 16rpx; padding: 18rpx; border-radius: 12rpx; color: #005536; background: #e9f4ee; }
.badge { padding: 8rpx 14rpx; border-radius: 999rpx; background: #f4ead9; color: #8a5a0a; font-weight: 800; }
.media-list { display: grid; gap: 10rpx; margin: 4rpx 0 12rpx; }
.media-item { padding: 14rpx 16rpx; border-radius: 12rpx; background: #f7f5ef; color: #26342d; font-size: 25rpx; }
