<view class="page">
  <view class="section">
    <view class="section-title">订单验收</view>
    <view class="row"><view class="label">订单号</view><view class="value">{{order.id}}</view></view>
    <view class="row"><view class="label">维修内容</view><view class="value">{{order.title}}</view></view>
    <view class="row"><view class="label">上门时间</view><view class="value">{{order.visitTime}}</view></view>
    <view class="row"><view class="label">服务师傅</view><view class="value">{{order.masters}}</view></view>
    <view class="row"><view class="label">订单金额</view><view class="value">¥{{order.orderAmount}}</view></view>
  </view>

  <view class="section">
    <view class="section-title">师傅完工凭证</view>
    <view class="row"><view class="label">完工图片</view><view class="value">{{cycle.completionMedia.images.length}} 张</view></view>
    <view class="media-list" wx:if="{{completionImageItems.length}}">
      <view wx:for="{{completionImageItems}}" wx:key="index" class="media-item">图片{{item.index}}：{{item.name}}</view>
    </view>
    <view class="row"><view class="label">完工视频</view><view class="value">{{cycle.completionMedia.videos.length}} 个</view></view>
    <view class="media-list" wx:if="{{completionVideoItems.length}}">
      <view wx:for="{{completionVideoItems}}" wx:key="index" class="media-item">视频{{item.index}}：{{item.name}}</view>
    </view>
    <view class="muted">{{cycle.completionNote}}</view>
  </view>

  <view class="section">
    <view class="section-title">验收结果</view>
    <view class="actions">
      <view class="btn {{result === 'pass' ? 'btn-primary' : 'btn-ghost'}}" data-value="pass" bindtap="chooseResult">✓ 通过验收</view>
      <view class="btn {{result === 'fail' ? 'btn-danger' : 'btn-ghost'}}" data-value="fail" bindtap="chooseResult">不通过</view>
    </view>
    <view class="btn btn-primary" bindtap="submitPass" wx:if="{{result === 'pass'}}">确认通过验收</view>
    <view wx:if="{{result === 'fail'}}">
      <view class="field">
        <view class="field-label">上传验收图片 / 视频 <text class="required">*</text></view>
        <view class="media-box" bindtap="addIssueMedia">{{issueMediaLabel}}</view>
        <view wx:if="{{uploadMessage}}" class="muted">{{uploadMessage}}</view>
        <view wx:if="{{uploadFailed}}" class="btn btn-secondary" bindtap="addIssueMedia">重试上传</view>
      </view>
      <view class="field">
        <view class="field-label">问题说明 <text class="required">*</text></view>
        <textarea class="textarea" value="{{issue.description}}" bindinput="inputIssue" placeholder="请说明需要返修的问题" />
      </view>
      <view class="btn btn-primary" bindtap="submitFail">提交验收问题</view>
    </view>
    <view wx:if="{{message}}" class="toast">{{message}}</view>
  </view>
</view>
