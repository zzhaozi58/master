<view class="page">
  <view class="section-title">我的订单</view>
  <scroll-view scroll-x class="tabs">
    <view wx:for="{{tabs}}" wx:key="name" data-name="{{item.name}}" bindtap="switchTab" class="tab {{activeTab === item.name ? 'active' : ''}}">{{item.name}} {{item.count}}</view>
  </scroll-view>

  <view wx:if="{{orders.length === 0}}" class="empty">暂无{{activeTab}}订单</view>

  <view wx:for="{{orders}}" wx:key="id" class="section">
    <view class="row">
      <view class="section-title">{{item.title}}</view>
      <view class="value">{{item.progress}}</view>
    </view>
    <view class="row"><view class="label">订单号</view><view class="value">{{item.id}}</view></view>
    <view wx:if="{{activeTab !== '已完成'}}" class="row"><view class="label">上门时间</view><view class="value">{{item.visitTime}}</view></view>
    <view wx:if="{{activeTab !== '已完成'}}" class="row"><view class="label">服务师傅</view><view class="value">{{item.masters}}</view></view>
    <view class="row"><view class="label">订单金额</view><view class="value">{{item.orderAmountText}}</view></view>
    <view wx:if="{{activeTab === '已完成'}}" class="row"><view class="label">付款状态</view><view class="value">{{item.customerPaymentStatus}}</view></view>
    <view wx:if="{{activeTab === '待确认报价'}}" class="section">
      <view class="row"><view class="label">维修报价</view><view class="value">¥{{item.quote.repairFee}}</view></view>
      <view class="row"><view class="label">上门费</view><view class="value">¥{{item.quote.visitFee}}</view></view>
      <view class="row"><view class="label">报价合计</view><view class="value">¥{{item.quote.total}}</view></view>
      <view class="muted">{{item.quote.description}}</view>
    </view>
    <view class="actions">
      <view wx:if="{{activeTab === '待确认报价'}}" class="btn {{submitting ? 'btn-disabled' : 'btn-primary'}}" data-id="{{item.id}}" bindtap="confirmQuote">确认报价</view>
      <view wx:if="{{activeTab === '待确认报价'}}" class="btn btn-secondary" bindtap="callService">对报价有疑问</view>
      <view wx:if="{{item.canAccept}}" class="btn btn-primary" data-id="{{item.id}}" bindtap="goAcceptance">验收此订单</view>
      <view wx:if="{{item.canCancel}}" class="btn {{submitting ? 'btn-disabled' : 'btn-danger'}}" data-id="{{item.id}}" bindtap="cancelOrder">申请取消</view>
      <view wx:if="{{activeTab === '已完成'}}" class="btn btn-secondary" data-id="{{item.id}}" bindtap="goDetail">查看详情</view>
    </view>
  </view>

  <view wx:if="{{message}}" class="toast">{{message}}</view>
</view>
