page {
  background: #f7f5ef;
  color: #12231c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page {
  padding: 24rpx 24rpx 144rpx;
}

.hero {
  background: #005536;
  color: #fff;
  padding: 36rpx 28rpx;
  border-radius: 0 0 16rpx 16rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.logo {
  width: 92rpx;
  height: 92rpx;
  flex: none;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, .82);
  font-size: 25rpx;
}

.section {
  margin-top: 24rpx;
  background: #fff;
  border: 1rpx solid #e8dcc8;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #005536;
  margin-bottom: 18rpx;
}

.muted {
  color: #69766f;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0;
  font-size: 27rpx;
}

.label {
  color: #69766f;
  flex: none;
}

.value {
  text-align: right;
  font-weight: 700;
}

.input,
.textarea,
.picker {
  min-height: 88rpx;
  border: 1rpx solid #ded2c0;
  border-radius: 12rpx;
  padding: 0 22rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 150rpx;
  padding-top: 18rpx;
}

.field {
  margin-top: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.required {
  color: #b3261e;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  min-height: 72rpx;
  padding: 0 22rpx;
  border: 1rpx solid #ded2c0;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #26342d;
  background: #fff;
}

.chip.active {
  color: #005536;
  background: #e9f4ee;
  border-color: #005536;
  font-weight: 800;
}

.checkbox.active::before {
  content: "✓";
  margin-right: 8rpx;
  font-weight: 900;
}

.tabs {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding: 18rpx 0 8rpx;
}

.tab {
  flex: none;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #69766f;
  border: 1rpx solid #eadfcc;
  font-size: 25rpx;
}

.tab.active {
  background: #005536;
  color: #fff;
  border-color: #005536;
  font-weight: 800;
}

.btn {
  min-height: 88rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 30rpx;
}

.btn-primary {
  color: #fff;
  background: #007846;
}

.btn-secondary {
  color: #005536;
  background: #eef6f1;
  border: 1rpx solid #005536;
}

.btn-ghost {
  color: #005536;
  background: #fff;
  border: 1rpx solid #ded2c0;
}

.btn-danger {
  color: #8a241d;
  background: #fff2ef;
  border: 1rpx solid #e8b6ad;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.empty {
  padding: 80rpx 0;
  color: #69766f;
  text-align: center;
}

.media-box {
  border: 1rpx dashed #cbbda8;
  min-height: 148rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #69766f;
  background: #fffaf2;
}

.media-list {
  display: grid;
  gap: 10rpx;
  margin: 4rpx 0 12rpx;
}

.media-item {
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f7f5ef;
  color: #26342d;
  font-size: 25rpx;
}

.toast {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  color: #005536;
  background: #e9f4ee;
}
