<view class="page">
  <view class="section">
    <view class="section-title">注册 / 完善资料</view>
    <view class="muted">新注册师傅默认铜牌，提交后等待管理员审核。</view>
    <view wx:if="{{form.reviewStatus === '已拒绝'}}" class="toast">审核未通过：{{form.reviewReason}}。修改资料后可重新提交审核。</view>
    <view class="field"><view class="field-label">姓名 *</view><input class="input" value="{{form.name}}" data-field="name" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">性别 *</view><input class="input" value="{{form.gender}}" data-field="gender" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">微信号 *</view><input class="input" value="{{form.wechat}}" data-field="wechat" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">手机号 *</view><input class="input" type="number" value="{{form.phone}}" data-field="phone" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">城市 *</view><input class="input" value="{{form.city}}" data-field="city" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">区 / 县 *</view><input class="input" value="{{form.district}}" data-field="district" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">街道 *</view><input class="input" value="{{form.street}}" data-field="street" bindinput="inputField" /></view>
    <view class="field"><view class="field-label">个人介绍</view><textarea class="textarea" value="{{form.intro}}" data-field="intro" bindinput="inputField" /></view>
    <view class="btn {{submitting ? 'btn-disabled' : 'btn-primary'}}" bindtap="submit">提交资料</view>
    <view wx:if="{{message}}" class="toast">{{message}}</view>
  </view>
</view>
