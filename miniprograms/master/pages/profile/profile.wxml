<view class="page">
  <view class="section">
    <view class="row"><view class="section-title">{{master.name}}</view><view class="badge">{{master.level}}</view></view>
    <view class="row"><view class="label">审核状态</view><view class="value">{{master.reviewStatus}}</view></view>
    <view wx:if="{{master.reviewStatus === '已拒绝'}}" class="row"><view class="label">拒绝原因</view><view class="value">{{master.reviewReason}}</view></view>
    <view class="row"><view class="label">微信号</view><view class="value">{{master.wechat}}</view></view>
    <view class="row"><view class="label">手机号</view><view class="value">{{master.phone}}</view></view>
    <view class="row"><view class="label">常住地址</view><view class="value">{{master.city}}{{master.district}}{{master.street}}</view></view>
    <view class="row"><view class="label">个人介绍</view><view class="value">{{master.intro}}</view></view>
    <view class="btn btn-secondary" bindtap="openRegister">编辑资料</view>
  </view>
  <view class="section">
    <view class="section-title">金额</view>
    <view class="row"><view class="label">本月应收金额</view><view class="value">¥{{summary.receivable}}</view></view>
    <view class="row"><view class="label">实收金额</view><view class="value">¥{{summary.paid}}</view></view>
  </view>
</view>
